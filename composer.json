{
  "name": "evolution-cms/ecodemirror",
  "license": "GPL-2.0",
  "type": "evolutioncms-plugin",
  "description": "CodeMirror 6 for Evolution CMS",
  "keywords": [
    "evo",
    "evocms",
    "evolution-cms",
    "codemirror",
    "editor"
  ],
  "require": {
    "php": "^8.3",
    "evolution-cms/evolution": "^3.5.2"
  },
  "autoload": {
    "psr-4": {
      "EvolutionCMS\\eCodeMirror\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "EvolutionCMS\\eCodeMirror\\eCodeMirrorServiceProvider"
      ]
    }
  }
}
